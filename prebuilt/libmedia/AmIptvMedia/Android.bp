cc_prebuilt_library_shared {

    name: "libAmIptvMedia",
    system_ext_specific: true,
    compile_multilib: "32",
    check_elf_files: false,

    shared_libs: [
        "libamavutils_sys",
    ],

    arch: {
        arm: {
            srcs: ["libAmIptvMedia.so"],
        },
        arm64: {
            enabled: false,
        },
        x86: {
            enabled: false,
        },
        x86_64: {
            enabled: false,
        },
    },
}