// This is the expected build file, but it may not be right in all cases
package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   legacy_proprietary
    default_applicable_licenses: ["vendor_amlogic_common_license"],
}

aidl_interface {
    name: "vendor.amlogic.hardware.mediahalserver",
    vendor_available: true,
    srcs: ["vendor/amlogic/hardware/mediahalserver/*.aidl"],
    stability: "vintf",
    owner: "amlogic",
    imports: [
        "android.hardware.common-V2",
        "android.hardware.common.fmq-V1",
    ],
    backend: {
        cpp: {
            // prefer NDK backend which can be used anywhere
            // If you disable this, you also need to delete the C++
            // translate code.
            enabled: false,
        },
        java: {
            sdk_version: "module_current",
        },
        ndk: {
            enabled: true,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [
                "android.hardware.common-V2",
                "android.hardware.common.fmq-V1",
            ],
        },
    ],
    frozen: true,

}
