package vendor.amlogic.hardware.mediahalserver@1.0;

@export
enum Result : uint32_t {
    OK,                     // Success
    INVALID_PARAMS,         // Invalid parameters
    INVALID_OPERATION,      // Invalid operation
    INVALID_OBJECT,         // Invalid object
    INVALID_STATE,          // Invalid state
    RETRY,                  // Retry
    BUSY,                   // Device busy
    END_OF_STREAM,          // End of stream
    IO_ERROR,               // Io error
    WOULD_BLOCK,            // Blocking error
    NOT_SUPPORTED,          // Not supported
    UNKNOWN_ERROR,          // Unknown error
};

/**
 * AvSyncHwId
 */
typedef uint32_t AvSyncHwId;

@export
enum MediaTimeType : uint32_t {
    MEDIA_TIME_TYPE_VIDEO,
    MEDIA_TIME_TYPE_AUDIO,
    MEDIA_TIME_TYPE_PCR,
    MEDIA_TIME_TYPE_STC,
};

@export
enum TimeUnit : uint32_t {
    TIME_UNIT_MS,
    TIME_UNIT_US,
    TIME_UNIT_PTS,
};
