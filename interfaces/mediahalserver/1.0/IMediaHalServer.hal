package vendor.amlogic.hardware.mediahalserver@1.0;

import IMediaSync;

interface IMediaHalServer {

    /**
     * open a session
     *
     * @return result, Result status of the operation.
     *         OK if successful,
     *         UNKNOWN_ERROR if failed for other reasons.
     * @return sessionId, sessionId is unique id to specify
     *         the client. We support multi client here.
     */
    openSession() generates (Result result, int32_t sessionId);

    /**
     * close a session
     *
     * @param sessionId
     *
     * @return result, Result status of the operation.
     *         OK if successful,
     *         UNKNOWN_ERROR if failed for other reasons.
     */
    closeSession(uint32_t sessionId) generates (Result result);

    createMediaSync(uint32_t sessionId) generates (Result result, IMediaSync mediasync);
};
