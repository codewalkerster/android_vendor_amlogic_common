    default_applicable_licenses: ["vendor_amlogic_common_license"],
}

aidl_interface {
    name: "vendor.amlogic.hardware.miracast_hdcp2",
    vendor_available: true,
    host_supported: false,
    frozen: true,
    srcs: ["vendor/amlogic/hardware/miracast_hdcp2/*.aidl"],
    owner: "vendor",
    versions_with_info: [
        {
            version: "1",
            imports: [],
        }
    ],
    stability: "vintf",
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: false,
        },
        ndk: {
            enabled: true,
        },
    },
}

