package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["vendor_amlogic_common_license"],
}

cc_binary {
    name: "droidaudio_sys_tester",
    system_ext_specific: true,
    compile_multilib: "32",
    srcs: [
        "main.cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libutils",
        "libcutils",
        "libbinder",
        "libbinder_ndk",
        "libdroidaudioclient",
        "vendor.amlogic.hardware.droidaudio-V1-ndk",
    ],

    required: [
        "vendor.amlogic.hardware.droidaudio-V1-ndk",
        "libdroidaudioclient",
    ],

    header_libs: [
        "libhardware_headers",
        "libaudio_system_headers",
        "libutils_headers",
        "libbinder_headers",
    ],

    include_dirs: [
        "vendor/amlogic/common/interfaces/droidaudio/default/libdroidaudioclient",
    ],
}

cc_binary {
    name: "droidaudio_vnd_tester",
    vendor: true,
    compile_multilib: "32",

    srcs: [
        "main.cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libutils",
        "libcutils",
        "libbinder",
        "libbinder_ndk",
        "libdroidaudioclient",
        "vendor.amlogic.hardware.droidaudio-V1-ndk",
    ],

    required: [
        "vendor.amlogic.hardware.droidaudio-V1-ndk",
        "libdroidaudioclient",
    ],

    header_libs: [
        "libhardware_headers",
        "libaudio_system_headers",
        "libutils_headers",
        "libbinder_headers",
    ],

    include_dirs: [
        "vendor/amlogic/common/interfaces/droidaudio/default/libdroidaudioclient",
    ],
}
