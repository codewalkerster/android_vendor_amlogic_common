package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["vendor_amlogic_common_license"],
}

aidl_interface {
    name: "vendor.amlogic.hardware.droidaudio",
    owner: "vendor.amlogic.hardware.droidaudio",
    vendor_available: true,
    system_ext_specific: true,
    stability: "vintf",
    srcs: ["vendor/amlogic/hardware/droidaudio/*.aidl"],
    imports: [
//        "android.hardware.common-V2",
    ],
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: true,
            platform_apis: true,
            sdk_version: "system_current",
        },
        ndk: {
            enabled: true,
            min_sdk_version: "current",
        },
    },
    double_loadable: true,
}

