package {
    // See: http://go/android-license-faq
    // Added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_google_misc_hotwordenrollment_license"
    // to get the below license kinds:
    //   legacy_proprietary
    default_applicable_licenses: [
        "Android-Apache-2.0",
        "vendor_google_misc_hotwordenrollment_license",
    ],
}

java_sdk_library {
    name: "com.android.hotwordenrollment.common.util",
    owner: "google",
    dist_group: "google",
    srcs: ["src/**/*.java"],
    api_packages: ["com.android.hotwordenrollment.common"],
    system_ext_specific: true,
    unsafe_ignore_missing_latest_api: true,
}
