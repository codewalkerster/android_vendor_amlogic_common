package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["vendor_amlogic_common_license"],
}

bootstrap_go_package {
    name: "soong-aml-audio-policy-manager-engine",
    pkgPath: "android/soong/vendor/amlogic/common/frameworks/native/libaudiopolicyengine_amlogic",
    deps: [
        "blueprint",
        "blueprint-pathtools",
        "soong",
        "soong-android",
        "soong-cc",
        "soong-genrule",
    ],
    srcs: [
        "aml_audio_policy_manager_engine_default.go",
    ],
    pluginFor: ["soong_build"],
}

aml_audio_policy_manager_engine_defaults {
    name: "aml_audio_policy_manager_engine_defaults",
}

cc_library_shared {
    name: "libaudiopolicyengine_amlogic",
    defaults: [
        "aml_audio_policy_manager_engine_defaults",
    ],
    srcs: [
        "src/Engine.cpp",
        "src/EngineInstance.cpp",
    ],

    cflags: [
        "-fvisibility=hidden",
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    header_libs: [
        "libbase_headers",
        "libaudiopolicycommon",
        "libaudiopolicyengine_interface_headers",
    ],
    static_libs: [
        "libaudiopolicyengine_common",
        "libaudiopolicyengine_config",
    ],
    shared_libs: [
        "libaudiofoundation",
        "libbase",
        "liblog",
        "libcutils",
        "libutils",
        "libmedia_helper",
        "libaudiopolicy",
        "libxml2",
    ],
}
