package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    default_applicable_licenses: ["vendor_amlogic_common_license"],
}

bootstrap_go_package {
    name: "soong-aml-audio-policy-manager",
    pkgPath: "android/soong/vendor/amlogic/common/frameworks/native/libaudiopolicymanagercustom",
    deps: [
        "blueprint",
        "blueprint-pathtools",
        "soong",
        "soong-android",
        "soong-cc",
        "soong-genrule",
    ],
    srcs: [
        "aml_audio_policy_manager_default.go",
    ],
    pluginFor: ["soong_build"],
}

aml_audio_policy_manager_defaults {
    name: "aml_audio_policy_manager_defaults",
}

cc_library_shared {
    name: "libaudiopolicymanagercustom",
    system_ext_specific: true,
    defaults: [
        "latest_android_media_audio_common_types_cpp_shared",
        "aml_audio_policy_manager_defaults",
    ],

    srcs: [
        "AmlAudioPolicyManager.cpp",
    ],

    export_include_dirs: ["."],

    shared_libs: [
        "libaudiopolicymanagerdefault",
        "libaudiofoundation",
        "libcutils",
        "libdl",
        "libutils",
        "liblog",
        "libaudiopolicy",
        "libmedia_helper",
        "libbinder",
        "libhidlbase",
        "libxml2",
        // The default audio policy engine is always present in the system image.
        // libaudiopolicyengineconfigurable can be built in addition by specifying
        // a dependency on it in the device makefile. There will be no build time
        // conflict with libaudiopolicyenginedefault.
        "libaudiopolicyenginedefault",
        "framework-permission-aidl-cpp",
        "libaudioclient_aidl_conversion",
        "audioclient-types-aidl-cpp",
    ],

    header_libs: [
        "libaudiopolicycommon",
        "libaudiopolicyengine_interface_headers",
        "libaudiopolicymanager_interface_headers",
    ],

    cflags: [
        "-Wall",
        "-Werror",
    ],

}
