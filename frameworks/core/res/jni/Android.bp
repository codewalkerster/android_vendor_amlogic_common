package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_frameworks_core_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   legacy_proprietary
    default_applicable_licenses: [
        "vendor_amlogic_common_license",
    ],
}

cc_library_shared {
    name: "libjniuevent",

    srcs: ["uevent.cpp"],
    system_ext_specific: true,
    header_libs: ["jni_headers"],

    cflags: ["-Wno-unused-parameter"],

    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
    ],

}

prebuilt_etc {
    name: "bandwidth.rc",

    proprietary: true,

    src: "bandwidth.rc",
    sub_dir: "init/",

}

cc_binary {
    name: "magic_wake_daemon",
    vendor: true,
    srcs: ["magic_wake_daemon.c"],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

prebuilt_etc {
    name: "magic_wake_daemon.rc",
    src: "magic_wake_daemon.rc",
    vendor: true,
    sub_dir: "init",
}