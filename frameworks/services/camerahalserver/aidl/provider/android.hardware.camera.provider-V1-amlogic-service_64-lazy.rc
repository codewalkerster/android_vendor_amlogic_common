service vendor.camera.provider-ext /vendor/bin/hw/android.hardware.camera.provider-V1-amlogic-service_64-lazy
    interface aidl android.hardware.camera.provider.ICameraProvider/internal/0
    oneshot
    class hal
    user cameraserver
    group audio camera input drmrpc usb system mediadrm
    ioprio rt 4
    capabilities SYS_NICE
    task_profiles CameraServiceCapacity MaxPerformance
