package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   legacy_proprietary
    default_applicable_licenses: ["vendor_amlogic_common_license"],
}

soong_config_module_type {
    name: "android_hardware_audio_config_default",
    module_type: "cc_defaults",
    config_namespace: "android_hardware_audio",
    bool_variables: [
        "run_64bit",
    ],
    properties: ["compile_multilib"],
}

android_hardware_audio_config_default {
    name: "android_hardware_audio_config_defaults",

    soong_config_variables: {
        run_64bit: {
            conditions_default: {
                // Only support 32 bit as the binary must always be installed at the same
                // location for init to start it and the build system does not support
                // having two binaries installable to the same location even if they are
                // not installed in the same build.
                compile_multilib: "32",
            },
            compile_multilib: "64",
        },
    },
}
soong_config_module_type_import {
    from: "device/hardkernel/common/soong_config/Android.bp",
    module_types: ["amlogic_vendorconfig_cc_defaults"],
}

amlogic_vendorconfig_cc_defaults {
    name: "lowpower_hotword_defaults",

    soong_config_variables: {
        enable_lowpower_hotword: {
            cflags: ["-DPRODUCT_ENABLE_LOWPOWER_HOTWORD"],
        },
    },
}
///////////////////////////////////////
bootstrap_go_package {
    name: "soong-soundtrigger",
    pkgPath: "android/soong/vendor/amlogic/common/frameworks/services/audiohalserver",
    deps: [
        "blueprint",
        "blueprint-pathtools",
        "soong",
        "soong-android",
        "soong-cc",
        "soong-genrule",
    ],
    srcs: [
        "soundtrigger.go",
    ],
    pluginFor: ["soong_build"],
}
soundtrigger_go_defaults {
    name: "soundtrigger_go_defaults",
}

cc_binary {
    name: "android.hardware.audio.service-droidlogic",

    //init_rc: ["android.hardware.audio.service-droidlogic.rc"],
    relative_install_path: "hw",
    vendor: true,
    //vintf_fragments: ["soundtrigger/android.hardware.soundtringger@2.3-service.droidlogic.xml"],
    srcs: ["service.cpp"],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],

    shared_libs: [
        "libcutils",
        "libbinder",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libutils",
        "libhardware",
    ],

    defaults: [
        "android_hardware_audio_config_defaults",
        "lowpower_hotword_defaults",
        "soundtrigger_go_defaults",
    ],
}

// Legacy service name, use android.hardware.audio.service instead
phony {
    name: "android.hardware.audio@2.0-service-droidlogic",
    required: ["android.hardware.audio.service-droidlogic"],
}
