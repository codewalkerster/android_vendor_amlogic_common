package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_frameworks_services_systemcontrol_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   legacy_proprietary
    default_applicable_licenses: [
        "vendor_amlogic_common_frameworks_services_systemcontrol_license",
    ],
}

cc_binary {
    name: "test-systemcontrol",

    srcs: ["systemcontroltest.cpp"],

    shared_libs: [
        "libcutils",
        "libutils",
        "liblog",
        "libbinder",
        "libsystemcontrolservice",
        "vendor.amlogic.hardware.systemcontrol@1.0",
        "vendor.amlogic.hardware.systemcontrol@1.1",
        "libbase",
        "libhidlbase",
    ],


    cflags: ["-Wno-unused-function"],

    proprietary: true,

}
