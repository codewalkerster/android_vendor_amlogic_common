package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_frameworks_services_systemcontrol_PQ_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   legacy_by_exception_only (by exception only)
    //   legacy_notice
    //   legacy_unencumbered
    default_applicable_licenses: [
        "vendor_amlogic_common_frameworks_services_systemcontrol_PQ_license",
    ],
}

cc_library_static {
    name: "pq.tcon_common_static",
    proprietary: true,

    srcs: [
        "common/UkeyBlock.cpp",
        "common/UbootEnv.cpp",
        "common/PlatMisc.cpp",
    ],

    shared_libs: [
        "libcutils",
        "libutils",
        "liblog",
        "libdl",
        "libsystemcontrolservice",
        "vendor.amlogic.hardware.systemcontrol@1.1",
    ],

    cflags: [
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
        "-Wno-implicit-fallthrough",
    ],
}

