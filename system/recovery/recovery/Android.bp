package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "vendor_amlogic_common_system_recovery_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   SPDX-license-identifier-FTL
    //   SPDX-license-identifier-GPL
    //   SPDX-license-identifier-LGPL-2.1
    //   SPDX-license-identifier-MIT
    //   legacy_by_exception_only (by exception only)
    //   legacy_notice
    default_applicable_licenses: [
        "vendor_amlogic_common_system_recovery_license",
    ],
}

cc_library_static {
    name: "librecovery_amlogic",
    recovery_available: true,
    //vendor_available: true,
    //vndk: {
    //    enabled: true,
    //},
    srcs: [
        "recovery_amlogic.cpp",
    ],
    static_libs: [
        "liblog",
        "libbase",
        "libselinux",
        "libcutils",
        "libc++_static",
    ],
    cflags: ["-Werror"],
}

cc_library_static {
    name: "libenv_droid",
    recovery_available: true,

    srcs: [
        "uboot_env.cpp",
        "set_display_mode.cpp",
    ],
    static_libs: [
        "liblog",
        "libcutils",
        "libsystemcontrol_static",
        "libc++_static",
    ],
    cflags: ["-Werror"],
}

cc_library_static {
    name: "libamlogic_ui",
    recovery: true,
    //vendor_available: true,
    //vndk: {
    //    enabled: true,
    //},
    srcs: [
        "amlogic_ui.cpp",
    ],
    static_libs: [
        "liblog",
	"libbase",
        "libselinux",
        "libcutils",
        "libc++_static",
        "librecovery_amlogic",
        "librecovery_ui",
    ],
    cflags: ["-Werror"],
}
